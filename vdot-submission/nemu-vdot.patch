diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aa..86ec301 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -257,6 +257,50 @@ def_EHelper(vwredsum) {
 
 
 //op-m
+def_EHelper(vdot) {
+  require_vector(true);
+
+  // The custom operation is defined only for SEW=8, LMUL=1, vm=1 and
+  // vstart=0. Keep this check identical to the XiangShan RTL path.
+  if (vtype->vsew != 0 || vtype->vlmul != 0 || s->vm != 1 || vstart->val != 0) {
+    longjmp_exception(EX_II);
+  }
+
+  int32_t sum = 0;
+  for (int i = 0; i < 8; i++) {
+    const int8_t lhs = (int8_t)vreg_b(id_src->reg, i);
+    const int8_t rhs = (int8_t)vreg_b(id_src2->reg, i);
+    sum += (int32_t)lhs * (int32_t)rhs;
+  }
+
+  // Architectural result: signed low 32-bit scalar, remaining 96 bits zero.
+  vreg_l(id_dest->reg, 0) = (uint32_t)sum;
+  vreg_l(id_dest->reg, 1) = 0;
+  vstart->val = 0;
+  vp_set_dirty();
+}
+
+// vdota.vv: vd[31:0] += sum_i sext(vs1[i]) * sext(vs2[i]) (int32 wrap-around),
+// vd[127:32] = 0. Same legality rules as vdot.vv.
+def_EHelper(vdota) {
+  require_vector(true);
+  if (vtype->vsew != 0 || vtype->vlmul != 0 || s->vm != 1 || vstart->val != 0) {
+    longjmp_exception(EX_II);
+  }
+
+  uint32_t acc = (uint32_t)vreg_l(id_dest->reg, 0);   // only old vd[31:0] is read
+  for (int i = 0; i < 8; i++) {
+    const int8_t lhs = (int8_t)vreg_b(id_src->reg, i);
+    const int8_t rhs = (int8_t)vreg_b(id_src2->reg, i);
+    acc += (uint32_t)((int32_t)lhs * (int32_t)rhs);    // unsigned add: defined wrap-around
+  }
+
+  vreg_l(id_dest->reg, 0) = acc;
+  vreg_l(id_dest->reg, 1) = 0;
+  vstart->val = 0;
+  vp_set_dirty();
+}
+
 def_EHelper(vredsum) {
   REDUCTION(REDSUM, SIGNED);
 }
