+/** CIE 2026 custom vector instruction encodings.
+  *
+  * vdot.vv uses a reserved OPMVV funct6 value (001101), forces vm=1, and
+  * otherwise follows the standard OP-V register layout:
+  *   funct6 | vm | vs2 | vs1 | funct3=010 | vd | opcode=1010111
+  */
+object CIECustomInstructions {
+  def VDOT_VV = BitPat("b0011011??????????010?????1010111")
+  // Accumulating variant: vd[31:0] += dot(vs1, vs2); reserved OPMVV funct6 001110, vm = 1.
+  def VDOTA_VV = BitPat("b0011101??????????010?????1010111")
+}
+
 object Zimop {
   def MOP_R  = BitPat("b1?00??0111???????100?????1110011")
   def MOP_RR = BitPat("b1?00??1??????????100?????1110011")
